<?xml version="1.0" encoding="utf-8"?><!--
    Trust posture (vision.md; data-model.md §9): the local database is the
    unencrypted source of truth on-device. OS cloud backup or device-to-device
    transfer of it would bypass the client-side encryption boundary, so both
    are fully excluded. Sync, when the user opts in, goes through the
    encrypted container only (local-first-sync.md).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
