<?xml version="1.0" encoding="utf-8"?><!--
    Pre-Android-12 counterpart of data_extraction_rules.xml: OS auto-backup of
    the unencrypted local store is fully excluded (trust posture; allowBackup
    is false as well — this is defense in depth).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
